{
  "components": [
    {
      "name": "Mobile App",
      "kind": "mobile",
      "tech": "Kotlin 2.2, Jetpack Compose, Material 3",
      "responsibility": "Карта, текущая зона, статус и таймер сессии, уведомления, передача координат, переход к оплате"
    },
    {
      "name": "Admin Web",
      "kind": "web",
      "tech": "Angular 20, UI Kit, MapLibre",
      "responsibility": "Просмотр автомобилей, зон, сессий, маршрутов, журнала событий; загрузка зон; запуск демо-маршрута"
    },
    {
      "name": "Backend API",
      "kind": "backend",
      "tech": "ASP.NET Core 10, C# 14, EF Core + NetTopologySuite, SignalR",
      "responsibility": "REST API, определение зоны, жизненный цикл сессий, outbox событий, push обновлений в Admin Web"
    },
    {
      "name": "Background Worker",
      "kind": "worker",
      "tech": ".NET 10 BackgroundService",
      "responsibility": "Таймеры сессий (expiring/expired), публикация outbox в Kafka, создание уведомлений, проигрывание демо-маршрутов"
    },
    {
      "name": "PostgreSQL + PostGIS",
      "kind": "database",
      "tech": "PostgreSQL 17.9, PostGIS",
      "responsibility": "Данные, геозапросы, outbox, ключи идемпотентности"
    },
    {
      "name": "Kafka",
      "kind": "broker",
      "tech": "Apache Kafka",
      "responsibility": "Доменные события между компонентами"
    },
    {
      "name": "Parkomatica Mock",
      "kind": "mock",
      "tech": "ASP.NET Core minimal API",
      "responsibility": "Имитация API поставщика парковочных сессий за адаптером IParkingProvider"
    },
    {
      "name": "Official Payment Service",
      "kind": "external",
      "tech": "Сайт и приложения «Парковки Санкт-Петербурга» / «Парковки России»",
      "responsibility": "Оплата парковки водителем"
    }
  ],
  "operations": [
    {
      "operation_id": "createToken",
      "method": "post",
      "path": "/api/v1/auth/tokens",
      "summary": "Выдать JWT по логину и паролю",
      "tag": "Auth",
      "roles": [
        "anonymous"
      ],
      "fr": [
        "FR-15",
        "FR-16"
      ],
      "request": {
        "entity": "UserAccount",
        "fields": [
          "login"
        ],
        "extra": [
          {
            "name": "password",
            "type": "string",
            "required": true,
            "max_length": 128,
            "description": "пароль"
          }
        ]
      },
      "response": {
        "kind": "object",
        "entity": null,
        "fields": [],
        "extra": [
          {
            "name": "accessToken",
            "type": "string",
            "required": true,
            "max_length": 4000,
            "description": "JWT"
          },
          {
            "name": "expiresAt",
            "type": "datetime",
            "required": true,
            "description": "срок действия токена"
          },
          {
            "name": "role",
            "type": "enum",
            "required": true,
            "enum_values": [
              "driver",
              "dispatcher"
            ],
            "description": "роль"
          }
        ]
      },
      "success_status": 200,
      "errors": [
        401
      ],
      "idempotent": false,
      "rate_limited": true,
      "algorithm": [
        "1. Найти учётную запись по login (UserAccount)",
        "2. Проверить пароль по passwordHash и признак isActive",
        "3. Выпустить JWT с ролью и driverId, срок жизни 8 часов",
        "4. Вернуть accessToken, expiresAt, role"
      ],
      "exceptions": [
        "Учётная запись не найдена или пароль неверен → 401 invalid-credentials",
        "Учётная запись отключена → 401",
        "Более 10 попыток в минуту с одного адреса → 429"
      ],
      "tables": [
        "UserAccount"
      ],
      "external": [],
      "caching": null
    },
    {
      "operation_id": "getMyStatus",
      "method": "get",
      "path": "/api/v1/me/status",
      "summary": "Состояние для главного экрана водителя: зона, сессия, оставшееся время",
      "tag": "Me",
      "roles": [
        "driver"
      ],
      "fr": [
        "FR-3",
        "FR-9",
        "FR-14",
        "FR-16"
      ],
      "response": {
        "kind": "object",
        "entity": null,
        "fields": [],
        "extra": [
          {
            "name": "vehicleId",
            "type": "uuid",
            "required": true,
            "description": "закреплённый автомобиль"
          },
          {
            "name": "plateNumber",
            "type": "string",
            "required": true,
            "max_length": 9,
            "description": "госномер"
          },
          {
            "name": "zoneId",
            "type": "uuid",
            "required": false,
            "description": "текущая зона"
          },
          {
            "name": "zoneNumber",
            "type": "string",
            "required": false,
            "max_length": 4,
            "description": "номер текущей зоны"
          },
          {
            "name": "sessionId",
            "type": "uuid",
            "required": false,
            "description": "активная сессия"
          },
          {
            "name": "sessionStatus",
            "type": "enum",
            "required": false,
            "enum_values": [
              "active",
              "expiring",
              "expired",
              "closed"
            ],
            "description": "статус сессии"
          },
          {
            "name": "paidUntil",
            "type": "datetime",
            "required": false,
            "description": "оплачено до"
          },
          {
            "name": "remainingMinutes",
            "type": "int",
            "required": false,
            "minimum": 0,
            "description": "осталось минут"
          },
          {
            "name": "lastPositionAt",
            "type": "datetime",
            "required": false,
            "description": "время последней координаты"
          }
        ]
      },
      "success_status": 200,
      "errors": [
        404
      ],
      "algorithm": [
        "1. Взять driverId из токена, найти закреплённый автомобиль",
        "2. Прочитать currentZoneId и lastPositionAt автомобиля",
        "3. Найти активную сессию автомобиля (status active или expiring)",
        "4. Посчитать remainingMinutes = paidUntil − now, вернуть состояние"
      ],
      "exceptions": [
        "За водителем не закреплён автомобиль → 404"
      ],
      "tables": [
        "Driver",
        "Vehicle",
        "ParkingZone",
        "ParkingSession"
      ],
      "external": [],
      "caching": null
    },
    {
      "operation_id": "submitPosition",
      "method": "post",
      "path": "/api/v1/vehicles/{vehicleId}/positions",
      "summary": "Передать координату автомобиля; ответ содержит определённую зону и переход",
      "tag": "Positions",
      "roles": [
        "driver"
      ],
      "fr": [
        "FR-1",
        "FR-2",
        "FR-6",
        "FR-7",
        "FR-8",
        "FR-13"
      ],
      "request": {
        "entity": "VehiclePosition",
        "fields": [
          "point",
          "recordedAt",
          "accuracyM",
          "speedKmh",
          "source"
        ],
        "extra": []
      },
      "response": {
        "kind": "object",
        "entity": null,
        "fields": [],
        "extra": [
          {
            "name": "zoneId",
            "type": "uuid",
            "required": false,
            "description": "текущая зона после обработки точки"
          },
          {
            "name": "zoneNumber",
            "type": "string",
            "required": false,
            "max_length": 4,
            "description": "номер зоны"
          },
          {
            "name": "transition",
            "type": "enum",
            "required": true,
            "enum_values": [
              "none",
              "entered",
              "exited",
              "changed"
            ],
            "description": "изменение зоны"
          },
          {
            "name": "notification",
            "type": "string",
            "required": false,
            "max_length": 300,
            "description": "текст уведомления для немедленного показа"
          }
        ]
      },
      "success_status": 202,
      "errors": [
        404,
        422
      ],
      "rate_limited": true,
      "algorithm": [
        "1. Проверить, что автомобиль закреплён за водителем из токена",
        "2. Проверить координаты, recordedAt (не позже now + 5 мин) и точность",
        "3. Если точка с тем же recordedAt уже есть — вернуть сохранённый результат",
        "4. Найти зону ST_Contains по GIST-индексу; точки с точностью хуже 100 м зону не меняют",
        "5. Сравнить с двумя последними точками: при смене зоны записать ParkingEvent и outbox в одной транзакции",
        "6. Обновить Vehicle.currentZoneId и lastPositionAt",
        "7. Вернуть zoneId, zoneNumber, transition и текст уведомления"
      ],
      "exceptions": [
        "Чужой автомобиль → 403 vehicle-not-assigned",
        "Автомобиль не найден → 404",
        "recordedAt в будущем более чем на 5 минут → 422 position-from-future",
        "Координаты вне диапазона → 400",
        "Превышен лимит частоты → 429"
      ],
      "tables": [
        "Vehicle",
        "VehiclePosition",
        "ParkingZone",
        "ParkingEvent"
      ],
      "external": [],
      "caching": null
    },
    {
      "operation_id": "getRoute",
      "method": "get",
      "path": "/api/v1/vehicles/{vehicleId}/route",
      "summary": "Маршрут автомобиля за период",
      "tag": "Positions",
      "roles": [
        "driver",
        "dispatcher"
      ],
      "fr": [
        "FR-6",
        "FR-12",
        "FR-15"
      ],
      "query": [
        {
          "name": "from",
          "type": "datetime",
          "required": true,
          "description": "начало периода"
        },
        {
          "name": "to",
          "type": "datetime",
          "required": true,
          "description": "конец периода"
        }
      ],
      "response": {
        "kind": "object",
        "entity": null,
        "fields": [],
        "extra": [
          {
            "name": "path",
            "type": "linestring",
            "required": false,
            "description": "маршрут; отсутствует, если точек меньше двух"
          },
          {
            "name": "pointsCount",
            "type": "int",
            "required": true,
            "minimum": 0,
            "description": "число точек"
          }
        ]
      },
      "success_status": 200,
      "errors": [
        404
      ],
      "algorithm": [
        "1. Проверить доступ: водитель — только свой автомобиль, диспетчер — любой",
        "2. Выбрать точки VehiclePosition за [from, to] по индексу (vehicleId, recordedAt)",
        "3. Собрать LineString по порядку recordedAt, вернуть с числом точек"
      ],
      "exceptions": [
        "Период больше 31 дня или from > to → 400",
        "Автомобиль не найден → 404"
      ],
      "tables": [
        "VehiclePosition"
      ],
      "external": [],
      "caching": null
    },
    {
