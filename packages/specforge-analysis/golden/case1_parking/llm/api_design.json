  "sequences": [
    {
      "title": "Въезд в платную зону",
      "scenario": "UC_002",
      "steps": [
        {
          "source": "Mobile App",
          "target": "Backend API",
          "message": "POST /vehicles/{id}/positions (точка, recordedAt)"
        },
        {
          "source": "Backend API",
          "target": "PostgreSQL + PostGIS",
          "message": "ST_Contains: зона для точки, две последние точки"
        },
        {
          "source": "PostgreSQL + PostGIS",
          "target": "Backend API",
          "message": "зона 7801",
          "reply": true
        },
        {
          "source": "Backend API",
          "target": "PostgreSQL + PostGIS",
          "message": "ParkingEvent zone_entered + outbox в одной транзакции"
        },
        {
          "source": "Backend API",
          "target": "Mobile App",
          "message": "202 transition=entered, «Вы въехали в зону платной парковки»",
          "reply": true
        },
        {
          "source": "Background Worker",
          "target": "Kafka",
          "message": "parking.zone.entered.v1 из outbox"
        },
        {
          "source": "Kafka",
          "target": "Background Worker",
          "message": "parking.zone.entered → Notification"
        },
        {
          "source": "Backend API",
          "target": "Admin Web",
          "message": "SignalR: новое событие в журнале"
        }
      ]
    },
    {
      "title": "Запуск парковочной сессии",
      "scenario": "UC_003",
      "steps": [
        {
          "source": "Водитель",
          "target": "Mobile App",
          "message": "«Начать сессию», 1 час"
        },
        {
          "source": "Mobile App",
          "target": "Backend API",
          "message": "POST /sessions, Idempotency-Key"
        },
        {
          "source": "Backend API",
          "target": "Parkomatica Mock",
          "message": "IParkingProvider.StartSession(зона, автомобиль, 60 мин)"
        },
        {
          "source": "Parkomatica Mock",
          "target": "Backend API",
          "message": "providerSessionId, paidUntil 15:20",
          "reply": true
        },
        {
          "source": "Backend API",
          "target": "PostgreSQL + PostGIS",
          "message": "ParkingSession active + outbox session.started"
        },
        {
          "source": "Backend API",
          "target": "Mobile App",
          "message": "201 ParkingSession",
          "reply": true
        },
        {
          "source": "Mobile App",
          "target": "Водитель",
          "message": "«Парковка оплачена до 15:20»",
          "reply": true
        }
      ]
    },
    {
      "title": "Предупреждение об окончании и переход к оплате",
      "scenario": "UC_004",
      "steps": [
        {
          "source": "Background Worker",
          "target": "PostgreSQL + PostGIS",
          "message": "сессии с paidUntil ≤ now + 10 мин → status expiring + outbox"
        },
        {
          "source": "Background Worker",
          "target": "Kafka",
          "message": "parking.session.expiring.v1"
        },
        {
          "source": "Mobile App",
          "target": "Backend API",
          "message": "GET /me/notifications?unreadOnly=true (опрос) "
        },
        {
          "source": "Backend API",
          "target": "Mobile App",
          "message": "«До окончания парковки осталось 10 минут»",
          "reply": true
        },
        {
          "source": "Водитель",
          "target": "Mobile App",
          "message": "«Оплатить»"
        },
        {
          "source": "Mobile App",
          "target": "Backend API",
          "message": "GET /zones/{zoneId}/payment-link"
        },
        {
          "source": "Backend API",
          "target": "Mobile App",
          "message": "appUrl, webUrl",
          "reply": true
        },
        {
          "source": "Mobile App",
          "target": "Official Payment Service",
          "message": "deeplink с номером зоны"
        }
      ]
    }
  ],
  "no_api": []
