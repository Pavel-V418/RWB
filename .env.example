# Скопируйте в .env и заполните. CLI читает .env автоматически.

# --- LLM: любой OpenAI-совместимый эндпоинт (vLLM, OpenAI, Ollama, LM Studio, ...) ---
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=EMPTY
LLM_TIMEOUT_S=600
# Ретраи транспорта (сеть, 5xx, 429) внутри openai SDK.
LLM_MAX_RETRIES=3
# Способ получить JSON по схеме:
#   json_schema — response_format=json_schema (guided decoding в vLLM, structured outputs в OpenAI);
#   prompt      — схема передаётся текстом в промпте (для эндпоинтов без response_format).
LLM_STRUCTURED_MODE=json_schema
# Сколько раз просить модель исправить JSON, не прошедший валидацию.
LLM_STRUCTURED_ATTEMPTS=2
# true — передавать chat_template_kwargs.enable_thinking (vLLM + Qwen3). Для прочих эндпоинтов — false.
LLM_CHAT_TEMPLATE_KWARGS=false

# --- Логи ---
SPECFORGE_LOG_LEVEL=INFO
