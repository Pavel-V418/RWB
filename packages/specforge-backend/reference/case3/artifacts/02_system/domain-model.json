  "state_machines": [
    {
      "entity": "Tool",
      "field": "status",
      "states": [
        "available",
        "issued",
        "reserved",
        "repair",
        "lost",
        "retired"
      ],
      "transitions": [
        {
          "from_state": "available",
          "to_state": "reserved",
          "trigger": "create_reservation"
        },
        {
          "from_state": "reserved",
          "to_state": "available",
          "trigger": "cancel_reservation"
        },
        {
          "from_state": "available",
          "to_state": "issued",
          "trigger": "issue_tool"
        },
        {
          "from_state": "reserved",
          "to_state": "issued",
          "trigger": "issue_tool"
        },
        {
          "from_state": "issued",
          "to_state": "available",
          "trigger": "return_tool_working"
        },
        {
          "from_state": "issued",
          "to_state": "repair",
          "trigger": "return_tool_needs_repair"
        },
        {
          "from_state": "issued",
          "to_state": "lost",
          "trigger": "return_tool_lost"
        },
        {
          "from_state": "repair",
          "to_state": "available",
          "trigger": "repair_completed"
        },
        {
          "from_state": "available",
          "to_state": "retired",
          "trigger": "retire_tool"
        },
        {
          "from_state": "repair",
          "to_state": "retired",
          "trigger": "retire_tool"
        }
      ]
    },
    {
      "entity": "Reservation",
      "field": "status",
      "states": [
        "active",
        "cancelled",
        "fulfilled"
      ],
      "transitions": [
        {
          "from_state": "active",
          "to_state": "cancelled",
          "trigger": "cancel_reservation"
        },
        {
          "from_state": "active",
          "to_state": "fulfilled",
          "trigger": "issue_tool"
        }
      ]
    },
    {
      "entity": "IssueRecord",
      "field": "status",
      "states": [
        "active",
        "returned",
        "overdue"
      ],
      "transitions": [
        {
          "from_state": "active",
          "to_state": "overdue",
          "trigger": "scheduled_job_check_deadline"
        },
        {
          "from_state": "active",
          "to_state": "returned",
          "trigger": "return_tool"
        },
        {
          "from_state": "overdue",
          "to_state": "returned",
          "trigger": "return_tool"
        }
      ]
    },
    {
      "entity": "SyncQueue",
      "field": "status",
      "states": [
        "pending",
        "synced",
        "rejected"
      ],
      "transitions": [
        {
          "from_state": "pending",
          "to_state": "synced",
          "trigger": "sync_success"
        },
        {
          "from_state": "pending",
          "to_state": "rejected",
          "trigger": "sync_conflict"
        }
      ]
    }
  ],
  "notes": [
    "Срок возврата вычисляется как issueDate + N дней, где N хранится в SystemSetting (default 1)",
    "QR-код содержит инвентарный номер и генерируется сервером при создании Tool",
    "Конфликты синхронизации: операция отклоняется, если инструмент уже выдан (SyncQueue.status = rejected)",
    "События Kafka публикуются при issue, return, retire с eventType, toolId, employeeId, timestamp, payload",
    "Справочник сотрудников загружается из CSV с уникальным passNumber",
    "MovementHistory фиксирует все изменения для истории движения инструмента",
    "AuditLog фиксирует все действия пользователей для аудита",
    "Scheduled job периодически обновляет status IssueRecord на overdue при истечении returnDeadline"
  ]
}