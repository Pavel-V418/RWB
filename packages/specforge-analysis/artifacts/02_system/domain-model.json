        },
        {
          "from_state": "expiring",
          "to_state": "active",
          "trigger": "водитель подтвердил продление"
        },
        {
          "from_state": "expiring",
          "to_state": "expired",
          "trigger": "наступил paidUntil"
        },
        {
          "from_state": "expired",
          "to_state": "active",
          "trigger": "водитель подтвердил новую оплату"
        },
        {
          "from_state": "active",
          "to_state": "closed",
          "trigger": "водитель завершил сессию"
        },
        {
          "from_state": "expiring",
          "to_state": "closed",
          "trigger": "водитель завершил сессию"
        },
        {
          "from_state": "expired",
