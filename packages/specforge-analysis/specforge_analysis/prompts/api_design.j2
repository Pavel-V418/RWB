   "query": [], "request": {"entity": "Order", "fields": ["number"], "extra": []}, "response": {"kind": "object", "entity": "Order", "fields": []},
   "success_status": 201, "errors": [409, 422], "idempotent": true, "rate_limited": false,
   "algorithm": ["1. Проверить права роли operator", "2. ..."], "exceptions": ["Заказ с таким номером существует → 409"], "tables": ["Order"], "external": [], "caching": null}],
 "events": [{"name": "orders.order.created", "version": 1, "description": "...", "producer": "Backend API", "consumers": ["Worker"], "key": "orderId", "entity": "Order", "fields": ["id", "status"], "extra": [], "fr": ["FR-1"]}],
