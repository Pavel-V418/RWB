#!/bin/sh
# Поднять PostgreSQL внутри песочницы (кластер в $PGDATA, сокет в $PGHOST) и создать базу
# $PGDATABASE с расширением postgis. Идемпотентен: если сервер уже отвечает — ничего не делает.
set -eu

: "${PGDATA:=/tmp/pgdata}"
: "${PGHOST:=/tmp}"
: "${PGPORT:=5432}"
: "${PGDATABASE:=app}"

if pg_isready -q -h "$PGHOST" -p "$PGPORT"; then
  exit 0
fi

as_postgres() {
  if [ "$(id -u)" = "0" ]; then
    gosu postgres "$@"
  else
    "$@"
  fi
}

if [ ! -s "$PGDATA/PG_VERSION" ]; then
  mkdir -p "$PGDATA"
  [ "$(id -u)" = "0" ] && chown postgres:postgres "$PGDATA"
  as_postgres initdb -D "$PGDATA" -U postgres --auth=trust --encoding=UTF8 >/dev/null
fi

as_postgres pg_ctl -D "$PGDATA" -o "-k $PGHOST -p $PGPORT -c listen_addresses=''" \
  -l "$PGDATA/server.log" -w start >/dev/null

if ! psql -h "$PGHOST" -p "$PGPORT" -U postgres -d postgres -tAc \
  "SELECT 1 FROM pg_database WHERE datname = '$PGDATABASE'" | grep -q 1; then
  psql -h "$PGHOST" -p "$PGPORT" -U postgres -d postgres -qc "CREATE DATABASE \"$PGDATABASE\""
fi
psql -h "$PGHOST" -p "$PGPORT" -U postgres -d "$PGDATABASE" -qc "CREATE EXTENSION IF NOT EXISTS postgis"
echo "pg-up: PostgreSQL готов, база $PGDATABASE (postgis)"
