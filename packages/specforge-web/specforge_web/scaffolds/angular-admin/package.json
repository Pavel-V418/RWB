{
  "name": "specforge-admin",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:mock": "concurrently -k \"npm:mock\" \"ng serve --configuration mock --proxy-config proxy.mock.json\"",
    "mock": "prism mock -p 4010 --dynamic=false openapi.yaml",
    "build": "ng build",
    "test": "jest --ci",
    "lint:kit": "python3 tools/kit_lint.py src --manifest tools/kit-manifest.json",
    "gate": "npm run lint:kit && npm run build && npm test",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@angular/animations": "20.1.6",
    "@angular/common": "20.1.6",
    "@angular/compiler": "20.1.6",
    "@angular/core": "20.1.6",
    "@angular/forms": "20.1.6",
    "@angular/platform-browser": "20.1.6",
    "@angular/platform-browser-dynamic": "20.1.6",
    "@angular/router": "20.1.6",
    "@microsoft/signalr": "^9.0.6",
    "@primeuix/themes": "^1.2.1",
    "maplibre-gl": "^5.6.0",
    "primeicons": "^7.0.0",
    "primeng": "^20.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.1.0",
    "@angular/cli": "^20.1.0",
    "@angular/compiler-cli": "20.1.6",
    "@playwright/test": "^1.54.0",
    "@stoplight/prism-cli": "^5.14.2",
    "@types/jest": "^29.5.14",
    "axe-core": "^4.10.3",
    "concurrently": "^9.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.6.0",
    "typescript": "~5.8.3"
  }
}
