    {
      "operation_id": "createSessionExtension",
      "method": "post",
      "path": "/api/v1/sessions/{sessionId}/extensions",
      "summary": "Подтвердить продление оплаты",
      "tag": "Sessions",
      "roles": [
        "driver"
      ],
      "fr": [
        "FR-10",
        "FR-14"
      ],
      "request": {
        "entity": null,
        "fields": [],
        "extra": [
          {
            "name": "paidUntil",
            "type": "datetime",
            "required": true,
            "description": "новое время окончания оплаты"
          }
        ]
      },
      "response": {
        "kind": "object",
        "entity": "ParkingSession",
        "fields": []
      },
      "success_status": 200,
      "errors": [
        404,
        409,
        422,
        503
      ],
      "idempotent": true,
      "algorithm": [
        "1. Проверить ключ идемпотентности",
        "2. Проверить, что сессия принадлежит водителю и не закрыта",
        "3. Проверить, что новый paidUntil позже текущего времени и текущего paidUntil",
        "4. Обновить paidUntil, статус active; записать outbox parking.session.extended",
        "5. Вернуть сессию"
      ],
      "exceptions": [
        "Сессия не найдена → 404",
        "Сессия закрыта → 409 session-not-active",
        "paidUntil в прошлом → 422 paid-until-in-past",
        "Поставщик недоступен → 503"
      ],
      "tables": [
        "ParkingSession",
        "ParkingEvent"
