    {
      "operation_id": "createZoneImport",
      "method": "post",
      "path": "/api/v1/zone-imports",
      "summary": "Загрузить зоны из GeoJSON (снимок открытых данных или демо-набор)",
      "tag": "Zones",
      "roles": [
        "dispatcher"
      ],
      "fr": [
        "FR-21"
      ],
      "request": {
        "entity": "ParkingZone",
        "fields": [
          "dataSource",
          "dataVersion"
        ],
        "extra": [
          {
            "name": "featureCollection",
            "type": "json",
            "required": true,
            "description": "GeoJSON FeatureCollection зон"
          }
        ]
      },
      "response": {
        "kind": "object",
        "entity": null,
        "fields": [],
        "extra": [
          {
            "name": "imported",
            "type": "int",
            "required": true,
            "minimum": 0,
            "description": "загружено зон"
          },
          {
            "name": "skipped",
            "type": "int",
            "required": true,
            "minimum": 0,
            "description": "пропущено зон"
          },
          {
            "name": "errors",
            "type": "json",
            "required": false,
            "description": "ошибки по номерам зон"
          }
        ]
      },
      "success_status": 200,
      "errors": [
        422
      ],
      "algorithm": [
        "1. Проверить GeoJSON FeatureCollection",
        "2. Для каждой зоны проверить полигон ST_IsValid и номер",
        "3. Валидные зоны вставить или обновить по zoneNumber, невалидные — пропустить с причиной",
        "4. Вернуть imported, skipped и ошибки по номерам зон"
      ],
      "exceptions": [
        "Файл не GeoJSON FeatureCollection → 422",
        "Все зоны невалидны → 422 invalid-zone-geometry"
      ],
      "tables": [
        "ParkingZone"
      ],
      "external": [],
      "caching": null
    },
    {
      "operation_id": "startSession",
      "method": "post",
      "path": "/api/v1/sessions",
      "summary": "Запустить новую сессию или подтвердить оплаченную",
      "tag": "Sessions",
      "roles": [
        "driver"
      ],
      "fr": [
        "FR-5",
        "FR-14",
        "FR-17",
        "FR-19"
      ],
      "request": {
        "entity": "ParkingSession",
        "fields": [
          "vehicleId",
          "zoneId",
          "startMode"
        ],
        "extra": [
          {
            "name": "durationMinutes",
            "type": "int",
            "required": false,
            "minimum": 15,
            "maximum": 1440,
            "description": "длительность для режима started",
            "example": "60"
          },
          {
            "name": "confirmedPaidUntil",
            "type": "datetime",
            "required": false,
            "description": "оплачено до, для режима confirmed"
          }
        ]
      },
      "response": {
        "kind": "object",
        "entity": "ParkingSession",
        "fields": []
      },
      "success_status": 201,
      "errors": [
        409,
        422,
        503
      ],
      "idempotent": true,
      "algorithm": [
        "1. Проверить ключ идемпотентности: повтор возвращает первую сессию",
        "2. Проверить, что автомобиль закреплён за водителем и текущая зона равна zoneId",
        "3. Проверить, что в зоне нет активной сессии",
        "4. Режим started: вызвать IParkingProvider.StartSession(зона, автомобиль, durationMinutes); режим confirmed: принять confirmedPaidUntil",
        "5. Сохранить ParkingSession (active) и outbox parking.session.started в одной транзакции",
        "6. Вернуть сессию"
      ],
      "exceptions": [
        "Автомобиль не в платной зоне → 422 vehicle-not-in-paid-zone",
        "Активная сессия уже есть → 409 session-already-active",
        "confirmedPaidUntil в прошлом → 422 paid-until-in-past",
        "Поставщик не ответил за 5 с → 503 provider-unavailable"
      ],
      "tables": [
        "ParkingSession",
        "Vehicle",
        "ParkingEvent"
      ],
      "external": [
        "Parkomatica Mock (IParkingProvider)"
      ],
      "caching": null
    },
    {
